# Firebase Configuration — Copy this file to .env and fill in your values
# Get these values from: Firebase Console > Project Settings > Your apps > Web app

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id_here

# Web3Forms Configuration — For receiving contact form messages directly in your Gmail
# Get your free access key instantly at: https://web3forms.com (delivered to your Gmail)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
